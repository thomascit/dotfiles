#!/usr/bin/env bash
#
# Pre-commit hook: scan staged changes for secrets using gitleaks.
#
# Activate per-clone with:
#   git config core.hooksPath .githooks
# (setup.sh does this automatically.)
#
# Bypass in an emergency with:
#   git commit --no-verify
#

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks not found in PATH — skipping secret scan." >&2
  echo "[pre-commit] Install with: brew install gitleaks  (or see https://github.com/gitleaks/gitleaks)" >&2
  exit 0
fi

# Bail early if nothing is staged.
if git diff --cached --quiet; then
  exit 0
fi

# Scan the staged changes, never commit history: `gitleaks git --staged` would
# scan commits, not the index. The subcommand for this changed mid-v8, so probe
# for it instead of parsing `gitleaks version` — distro builds report useless
# strings like "version is set by build process".
#   v8.19+ : `gitleaks stdin`, fed the staged diff ("protect" was removed)
#   <v8.19 : `gitleaks protect --staged`, which reads the index itself
# --redact keeps matched secrets out of terminal scrollback.
if gitleaks stdin --help >/dev/null 2>&1; then
  scan_staged() { git diff --cached -U0 | gitleaks stdin --redact --no-banner; }
elif gitleaks protect --help >/dev/null 2>&1; then
  scan_staged() { gitleaks protect --staged --redact --no-banner; }
else
  echo "[pre-commit] gitleaks found but exposes neither 'stdin' nor 'protect' — skipping scan." >&2
  exit 0
fi

if ! scan_staged; then
  echo "" >&2
  echo "[pre-commit] gitleaks detected potential secrets in staged changes." >&2
  echo "[pre-commit] Review the findings above. To bypass (NOT recommended) use: git commit --no-verify" >&2
  exit 1
fi

exit 0
