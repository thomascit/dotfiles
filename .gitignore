.DS_Store
*.swp
*.swo
*~
.netrwhist
userstate.cbor
todo.md
test.md

# opencode: share agent definitions, ignore local state.
# Allow-list on purpose: opencode auto-populates this dir with node_modules,
# lockfiles, caches and possibly credentials, so default to excluding
# everything and opt files in explicitly.
# Note: `.opencode/*` (contents), not `.opencode/` (the dir) — git cannot
# re-include a file whose parent directory is excluded.
# To share more (e.g. skills/), add a matching `!` line below.
.opencode/*
!.opencode/agents/

# Fish-specific
fish/.config/fish/fish_variables
fish/.config/fish/fishd.*

# Tmux plugins (managed by TPM)
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/.gitkeep

# Neovim state
nvim/.config/nvim/.netrwhist
nvim/.config/nvim/plugin/
nvim/.config/nvim/lazy-lock.json

# Yazi plugins and flavors (managed by ya pkg, tracked via package.toml)
yazi/.config/yazi/plugins/*
!yazi/.config/yazi/plugins/.gitkeep
# Custom plugins (not managed by ya pkg)
!yazi/.config/yazi/plugins/folder-rules.yazi/
!yazi/.config/yazi/plugins/smart-switch.yazi/
yazi/.config/yazi/flavors/*
!yazi/.config/yazi/flavors/.gitkeep

# Secrets / sensitive files
.zenv
*.env
.env.*
*.pem
*.key
*.gpg
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
id_ecdsa
id_dsa
.netrc
*_secret*
*credentials*

